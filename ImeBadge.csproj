<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF는 켜지 않는다. UI Automation은 WPF 래퍼(System.Windows.Automation) 대신 COM으로 직접 호출한다
         (Program.cs의 Uia 클래스). WPF를 정적으로 참조하지 않아야 나중에 트리밍으로 WPF를 뺄 수 있다. -->
    <Nullable>enable</Nullable>
    <!-- 암시적 using을 끄고 소스에서 명시한다. (System.Windows.* 와 System.Drawing.* 의 동명 형식 충돌 방지) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ImeBadge</AssemblyName>
    <RootNamespace>ImeBadge</RootNamespace>

    <!-- 배포 파일 크기 줄이기 -->
    <!-- 프레임워크의 번역 리소스 DLL(cs, de, ja, ko ... 13개 언어)을 빼고 영어만 남긴다. 이 프로그램의 UI 문자열은
         소스에 직접 쓰여 있어 영향이 없다. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- self-contained single-file 번들 안의 어셈블리를 압축한다. 첫 실행 시 메모리에서 풀기 때문에
         시작이 수백 ms 느려지는 대신 크기가 절반 이하로 줄어든다. -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
