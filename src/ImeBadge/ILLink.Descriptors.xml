<?xml version="1.0" encoding="utf-8"?>
<!--
  트리밍(trimming)할 때 트리머(ILLink)가 절대 지우면 안 되는 형식 목록.

  Uia 클래스 안의 COM 인터페이스(IUIAutomation, IUIAutomationElement ...)는 메서드의 "선언 순서"가 곧
  네이티브 vtable 슬롯 번호다. 쓰지 않는 자리표시자(_Slot_*) 메서드를 트리머가 지우면 순서가 당겨져서
  GetFocusedElement()를 부른다는 것이 전혀 다른 함수를 호출하게 된다. 그래서 멤버 전체(preserve="all")를 보존한다.
  중첩 형식은 "바깥형식/안쪽형식" 으로 쓴다.

  보존을 빠뜨려 COM 인터페이스의 메서드가 잘리면 CI 의 tools/ComTrimCheck 가 그 형식 이름을 찍고 실패한다.
-->
<linker>
  <assembly fullname="ImeBadge">
    <type fullname="ImeBadge.Uia" preserve="all" />
    <type fullname="ImeBadge.Uia/CUIAutomation" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomation" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomationElement" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomationValuePattern" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomationTextPattern" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomationTextRangeArray" preserve="all" />
    <type fullname="ImeBadge.Uia/IUIAutomationTextRange" preserve="all" />
    <!-- TSF(msctf) COM 인터페이스도 같은 이유로 통째로 보존한다. -->
    <type fullname="ImeBadge.Tsf" preserve="all" />
    <type fullname="ImeBadge.Tsf/TfThreadMgr" preserve="all" />
    <type fullname="ImeBadge.Tsf/ITfThreadMgr" preserve="all" />
    <type fullname="ImeBadge.Tsf/ITfCompartmentMgr" preserve="all" />
    <type fullname="ImeBadge.Tsf/ITfCompartment" preserve="all" />
  </assembly>

  <!--
    .NET 자체의 COM 인터페이스(System.Runtime.InteropServices.ComTypes)도 같은 이유로 통째로 보존한다.
    WinForms 는 클립보드(OLE)에 이 인터페이스들을 쓰는데(DataObject 가 IDataObject·IEnumFORMATETC 를 구현), 트리머가
    IEnumFORMATETC 의 Skip/Clone, IAdviseSink·IEnumSTATDATA 의 메서드 전부를 지워 Clipboard.SetText 가
    "Fatal error. 0x80131506" 으로 프로세스를 즉시 끝냈다(try/catch 로도 못 잡음, 정보 창의 "진단 정보 복사").
    CoreLib 쪽(IEnumVARIANT, ITypeInfo 등)도 같은 식으로 잘려 있어 함께 보존한다.
  -->
  <assembly fullname="System.Runtime.InteropServices">
    <namespace fullname="System.Runtime.InteropServices.ComTypes" />
  </assembly>
  <assembly fullname="System.Private.CoreLib">
    <namespace fullname="System.Runtime.InteropServices.ComTypes" />
  </assembly>
</linker>
