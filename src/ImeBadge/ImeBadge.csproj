<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UseWPF는 켜지 않는다. UI Automation은 WPF 래퍼(System.Windows.Automation) 대신 COM으로 직접 호출한다
         (Native/Uia.cs). WPF를 정적으로 참조하면 아래 트리밍으로도 WPF를 뺄 수 없다. -->
    <Nullable>enable</Nullable>
    <!-- 암시적 using을 끄고 소스에서 명시한다. (System.Windows.* 와 System.Drawing.* 의 동명 형식 충돌 방지) -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>ImeBadge</AssemblyName>
    <RootNamespace>ImeBadge</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 프레임워크의 번역 리소스 DLL(cs, de, ja, ko ... 13개 언어)을 빼고 영어만 남긴다. 이 프로그램의 UI 문자열은
         소스에 직접 쓰여 있어 영향이 없다. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 버전. CI 가 태그(v1.2.3)에서 -p:Version=1.2.3 으로 덮어쓴다. 로컬 빌드는 0.0.0-dev 로 남아
         "업데이트 확인"이 개발 빌드에는 알림을 띄우지 않는다. -->
    <Version>0.0.0-dev</Version>
    <Product>ImeBadge</Product>
    <Company>kimch0627</Company>
    <Authors>kimch0627</Authors>
    <Copyright>Copyright © kimch0627. Apache License 2.0.</Copyright>
    <Description>한/영 입력 상태를 텍스트 커서 옆 배지로 보여 주는 Windows 트레이 프로그램</Description>
    <PackageProjectUrl>https://github.com/kimch0627/windows-ime-badge</PackageProjectUrl>
    <NeutralLanguage>ko-KR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImeBadge.Core\ImeBadge.Core.csproj" />
    <!-- 아이콘을 exe 안에 넣는다(embedded resource). Icons.cs 가 LogicalName 으로 찾는다. -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ImeBadge.Assets.app.ico" />
    <EmbeddedResource Include="Assets\paused.ico" LogicalName="ImeBadge.Assets.paused.ico" />
  </ItemGroup>

  <!--
    self-contained exe 크기 줄이기. dotnet publish 를 self-contained 옵션(런타임 포함)으로 실행할 때만 적용된다.
    (측정: 아무것도 안 하면 154 MB → 압축만 66 MB → 트리밍까지 약 19 MB)

    - EnableCompressionInSingleFile: 번들 안의 어셈블리를 압축. 첫 실행 때 메모리에서 풀어 수백 ms 느려진다.
    - PublishTrimmed + TrimMode=full: 트리머(ILLink)가 실제로 호출되는 코드만 남긴다. WinForms는 공식적으로는
      트리밍 미지원이라 _SuppressWinFormsTrimError 로 오류(NETSDK1175)를 끄고 쓴다. 문제가 생기면
      `-p:PublishTrimmed=false` 로 끄면 66 MB 짜리 안전한 빌드가 된다.
    - BuiltInComInteropSupport: 트리밍하면 기본값이 false 가 되어 [ComImport] COM 호출(Uia 클래스)이 막힌다. 켜 둔다.
    - ILLink.LinkAttributes.xml: ICommand 의 [TypeConverter] 속성이 WPF 전체(약 45 MB)를 끌어오는 고리를 끊는다.
    - ILLink.Descriptors.xml: COM 인터페이스(Uia)의 메서드 순서(vtable)가 트리밍으로 흐트러지지 않게 통째로 보존한다.
  -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- C# 컴파일 경고는 오류로 다루지만(TreatWarningsAsErrors), 트리머(ILLink)가 WinForms 프레임워크 어셈블리에서
         내는 경고(IL2104, IL2026 등)는 우리가 고칠 수 없는 것이라 오류로 올리지 않는다. -->
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
    <_ExtraTrimmerArgs>$(_ExtraTrimmerArgs) --link-attributes "$(MSBuildProjectDirectory)/ILLink.LinkAttributes.xml"</_ExtraTrimmerArgs>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    <!-- WinForms 어셈블리는 멤버 단위로 자르지 않고 통째로 남긴다. 자르면 창 핸들을 만들 때 내부 COM 인터페이스
         (IDropTarget 등, Control.SetAcceptDrops)가 없어 TypeLoadException 으로 죽는다. 다른 어셈블리는 계속 잘라낸다.
         (13.7 MB → 18.8 MB) -->
    <TrimmerRootAssembly Include="System.Windows.Forms" />
    <TrimmerRootAssembly Include="System.Windows.Forms.Primitives" />
  </ItemGroup>

  <!-- 트리밍 후에도 런타임 팩에서 그대로 복사되는 파일 중 이 프로그램에 필요 없는 것을 뺀다.
       Presentation*/wpfgfx/D3DCompiler/PenImc: WPF 네이티브·관리 DLL (WPF 창을 만들지 않음)
       mscordaccore*/mscordbi/createdump/DiaSymReader: 디버거·크래시 덤프 지원용 (실행에는 불필요) -->
  <Target Name="RemoveUnneededPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishTrimmed)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Presentation')) or $([System.String]::Copy('%(Filename)').StartsWith('wpfgfx')) or $([System.String]::Copy('%(Filename)').StartsWith('D3DCompiler')) or $([System.String]::Copy('%(Filename)').StartsWith('PenImc')) or $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) or '%(Filename)' == 'mscordbi' or '%(Filename)' == 'createdump' or '%(Filename)' == 'Microsoft.DiaSymReader.Native.amd64'" />
    </ItemGroup>
  </Target>
</Project>
