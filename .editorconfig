root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.iss]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_prefer_braces = when_multiline:none
dotnet_sort_system_directives_first = true
